{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include/**",
                "/usr/include/python3.10/**"
                // "/lib/modules/6.6.51+rpt-rpi-v8/source/include",
                // "/usr/src/linux-headers-6.6.51+rpt-rpi-v8//arch/arm64/include/generated",
                // "/usr/src/linux-headers-6.6.51+rpt-rpi-v8//include",
                // "/usr/src/linux-headers-6.6.51+rpt-common-rpi/arch/arm64/include"
            ],
            "defines": [
                "__KERNEL__",
                "__USE_POSIX",
                "__USE_GNU",
                "MODULE",
                "_POSIX_C_SOURCE=200809L", // POSIX.1-2008 표준 활성화
                "_GNU_SOURCE" // GNU 확장 활성화
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-gcc-x64"
        },
        {
            "name": "Arduino",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "ARDUINO=10819",
                "ARDUINO_AVR_UNO",
                "ARDUINO_ARCH_AVR",
                "F_CPU=16000000L",
                "__AVR__",
                "__AVR_ATmega328P__"
            ],
            "compilerPath": "/usr/bin/avr-gcc",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.vscode-arduino"
        }
    ],
    "version": 4
}