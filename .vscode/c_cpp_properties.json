{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include/**",
                "/usr/include/python3.10/**",
                "~/.arduino15/packages/esp32/hardware/esp32/**",
                "~/.arduino15/packages/esp32/tools/**"
            ],
            "defines": [
                "__KERNEL__",
                "__USE_POSIX",
                "__USE_GNU",
                "MODULE",
                "_POSIX_C_SOURCE=200809L",
                "_GNU_SOURCE",
                "ARDUINO=10819",
                "ARDUINO_ESP32_DEV",
                "ESP32",
                "BOARD_HAS_PSRAM",
                "CAMERA_MODEL_AI_THINKER"
            ],
            // "compilerPath": "/usr/bin/gcc",
            "compilerPath": "~/.arduino15/packages/esp32/tools/esp-x32/2411/bin/xtensa-esp32-elf-gcc",
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-gcc-x64"
        },
        {
            "name": "Arduino",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "ARDUINO=10819",
                "ARDUINO_AVR_UNO",
                "ARDUINO_ARCH_AVR",
                "F_CPU=16000000L",
                "__AVR__",
                "__AVR_ATmega328P__"
            ],
            "compilerPath": "/usr/bin/avr-gcc",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.vscode-arduino"
        }
    ],
    "version": 4
}